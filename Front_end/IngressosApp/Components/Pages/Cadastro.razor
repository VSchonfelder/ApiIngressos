@page "/cadastro"
@rendermode InteractiveServer
@using IngressosApp.Services
@inject EventoService EventoService
@inject UsuarioService UsuarioService
@inject CupomService CupomService

<h3>Cadastro</h3>

<button @onclick='() => abaAtiva = "evento"'>Evento</button>
<button @onclick='() => abaAtiva = "usuario"'>Usuário</button>
<button @onclick='() => abaAtiva = "cupom"'>Cupom</button>

<hr />

@if (abaAtiva == "evento")
{
    <h4>Cadastrar Novo Evento</h4>

    <div>
        <label>Nome do Evento</label>
        <input @bind="eventoNome" placeholder="Ex: Show do Coldplay" />
    </div>
    <div>
        <label>Data</label>
        <input type="date" @bind="eventoData" />
    </div>
    <div>
        <label>Local</label>
        <input @bind="eventoLocal" placeholder="Ex: Estádio do Maracanã" />
    </div>
    <button @onclick="CadastrarEvento">Cadastrar Evento</button>

    @if (mensagemEvento != "")
    {
        <p>@mensagemEvento</p>
    }
}

@if (abaAtiva == "usuario")
{
    <h4>Cadastrar Novo Usuário</h4>

    <div>
        <label>Nome</label>
        <input @bind="usuarioNome" placeholder="Ex: João Silva" />
    </div>
    <div>
        <label>Email</label>
        <input type="email" @bind="usuarioEmail" placeholder="Ex: joao@email.com" />
    </div>
    <div>
        <label>CPF</label>
        <input @bind="usuarioCpf" placeholder="Ex: 123.456.789-00" />
    </div>
    <div>
        <label>Senha</label>
        <input type="password" @bind="usuarioSenha" />
    </div>
    <button @onclick="CadastrarUsuario">Cadastrar Usuário</button>

    @if (mensagemUsuario != "")
    {
        <p>@mensagemUsuario</p>
    }
}

@if (abaAtiva == "cupom")
{
    <h4>Cadastrar Novo Cupom</h4>

    <div>
        <label>Código</label>
        <input @bind="cupomCodigo" placeholder="Ex: DESCONTO10" />
    </div>
    <div>
        <label>Porcentagem de Desconto (%)</label>
        <input type="number" @bind="cupomPorcentagem" min="1" max="100" />
    </div>
    <div>
        <label>Valor Mínimo do Pedido (R$)</label>
        <input type="number" @bind="cupomValorMinimo" min="0" />
    </div>
    <button @onclick="CadastrarCupom">Cadastrar Cupom</button>

    @if (mensagemCupom != "")
    {
        <p>@mensagemCupom</p>
    }
}

@code {
    private string abaAtiva = "usuario";

    // =========== Evento ===========
    private string eventoNome = "";
    private string eventoLocal = "";
    private DateTime eventoData = DateTime.Today;
    private string mensagemEvento = "";

    private void CadastrarEvento()
    {
        if (eventoNome == "" || eventoLocal == "")
        {
            mensagemEvento = "Preencha todos os campos!";
            return;
        }

        var resultado = EventoService.AdicionarEvento(new Evento
        {
            Nome = eventoNome,
            Data = eventoData,
            Local = eventoLocal
        });

        if (resultado != "ok")
        {
            mensagemEvento = resultado;
            return;
        }

        mensagemEvento = $"Evento '{eventoNome}' cadastrado com sucesso!";
        eventoNome = "";
        eventoLocal = "";
        eventoData = DateTime.Today;
    }
    // =========== Evento ===========


    // =========== Usuário ===========
    private string usuarioNome = "";
    private string usuarioEmail = "";
    private string usuarioCpf = "";
    private string usuarioSenha = "";
    private string mensagemUsuario = "";

    private void CadastrarUsuario()
    {
        if (usuarioNome == "" || usuarioEmail == "" || usuarioCpf == "" || usuarioSenha == "")
        {
            mensagemUsuario = "Preencha todos os campos!";
            return;
        }

        var resultado = UsuarioService.AdicionarUsuario(new Usuario
        {
            Nome = usuarioNome,
            Email = usuarioEmail,
            CPF = usuarioCpf,
            Senha = usuarioSenha
        });

        if (resultado != "ok")
        {
            mensagemUsuario = resultado;
            return;
        }

        mensagemUsuario = $"Usuário '{usuarioNome}' cadastrado com sucesso!";
        usuarioNome = "";
        usuarioEmail = "";
        usuarioCpf = "";
        usuarioSenha = "";
    }
    // =========== Usuário ===========


    // =========== Cupom ===========
    private string cupomCodigo = "";
    private decimal cupomPorcentagem = 0;
    private decimal cupomValorMinimo = 0;
    private string mensagemCupom = "";

    private void CadastrarCupom()
    {
        if (cupomCodigo == "" || cupomPorcentagem <= 0)
        {
            mensagemCupom = "Preencha todos os campos corretamente!";
            return;
        }

        var resultado = CupomService.AdicionarCupom(new Cupom
        {
            Codigo = cupomCodigo,
            PorcentagemDesconto = cupomPorcentagem,
            ValorMinimoRegra = cupomValorMinimo
        });

        if (resultado != "ok")
        {
            mensagemCupom = resultado;
            return;
        }

        mensagemCupom = $"Cupom '{cupomCodigo}' cadastrado com sucesso!";
        cupomCodigo = "";
        cupomPorcentagem = 0;
        cupomValorMinimo = 0;
    }
}