@page "/eventos"
@rendermode InteractiveServer
@using IngressosApp.Services
@inject EventoService EventoService

<h3>Eventos Disponíveis</h3>

@if (EventoService.GetEventos().Count == 0)
{
    <p>Nenhum evento cadastrado ainda.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Nome</th>
                <th>Data</th>
                <th>Local</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var evento in EventoService.GetEventos())
            {
                <tr>
                    <td>@evento.Nome</td>
                    <td>@evento.Data.ToShortDateString()</td>
                    <td>@evento.Local</td>
                </tr>
            }
        </tbody>
    </table>
}

<h3>Cupons Disponíveis</h3>

@inject CupomService CupomService

@if (CupomService.GetCupons().Count == 0)
{
    <p>Nenhum cupom disponível.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Código</th>
                <th>Desconto</th>
                <th>Valor Mínimo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cupom in CupomService.GetCupons())
            {
                <tr>
                    <td>@cupom.Codigo</td>
                    <td>@cupom.PorcentagemDesconto%</td>
                    <td>R$ @cupom.ValorMinimoRegra</td>
                </tr>
            }
        </tbody>
    </table>
}